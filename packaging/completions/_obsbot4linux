#compdef obsbot4linux
# zsh completion for obsbot4linux.
# Generated by scripts/regenerate.sh from the command-line definition and descriptions/*.json; do not edit.

_obsbot4linux_values() {
  case $1 in
    'audio.auto_gain') reply=(false off on true) ;;
    'audio.enabled') reply=(false off on true) ;;
    'audio.in_sleep') reply=(false off on true) ;;
    'audio.noise_reduction') reply=(medium off strong weak) ;;
    'exposure.anti_flicker') reply=(50hz 60hz off) ;;
    'exposure.hdr') reply=(false off on true) ;;
    'exposure.mode') reply=(auto manual) ;;
    'exposure.region') reply=(face global) ;;
    'factory_reset confirm') reply=(false off on true) ;;
    'focus.mode') reply=(continuous manual single) ;;
    'focus.region') reply=(face global) ;;
    'framing.auto_zoom') reply=(false off on true) ;;
    'framing.part') reply=(head_removal lower_body normal) ;;
    'framing.size') reply=(big_close_up close_up long_shot medium_close_up medium_long_shot medium_shot) ;;
    'framing.zoom_speed') reply=(fast medium slow) ;;
    'gestures.direction_change') reply=(false off on true) ;;
    'gestures.dynamic_zoom') reply=(false off on true) ;;
    'gestures.target_lock') reply=(false off on true) ;;
    'gestures.zoom') reply=(false off on true) ;;
    'gimbal.invert') reply=(false off on true) ;;
    'hand.axes.pan') reply=(false off on true) ;;
    'hand.axes.tilt') reply=(false off on true) ;;
    'hand.move_gimbal') reply=(false off on true) ;;
    'hand.side') reply=(left right) ;;
    'image.mirror') reply=(false off on true) ;;
    'image.white_balance.auto') reply=(false off on true) ;;
    'led.blink') reply=(false off on true) ;;
    'power_on.mode') reply=(close_up group hand headless lower_body normal static upper_body) ;;
    'power_on.start.mode') reply=(group headless normal static unset upper_body) ;;
    'sleep.auto.enabled') reply=(false off on true) ;;
    'sleep.background') reply=(black image) ;;
    'sleep.background_mirror') reply=(false off on true) ;;
    'tracking.mode') reply=(close_up group hand headless lower_body normal static upper_body) ;;
    'tracking.profile') reply=(headroom sport standard) ;;
    'tracking.speed') reply=(auto fast lazy normal slow very_fast) ;;
    'zone.enabled') reply=(false off on true) ;;
    'zone.follow') reply=(false off on true) ;;
    'zoom.field_of_view') reply=(medium narrow wide) ;;
    'zoom.move speed') reply=(fast medium slow) ;;
    *) reply=() ;;
  esac
}

_obsbot4linux_params() {
  case $1 in
    'factory_reset') reply=(confirm=) ;;
    'focus.point') reply=(x= y=) ;;
    'gimbal.move') reply=(pan= speed= tilt=) ;;
    'gimbal.turn') reply=(pan_speed= tilt_speed=) ;;
    'power_on.set_pose') reply=(pose=) ;;
    'power_on.use_preset') reply=(slot=) ;;
    'preset.delete') reply=(slot=) ;;
    'preset.recall') reply=(slot=) ;;
    'preset.rename') reply=(name= slot=) ;;
    'preset.save') reply=(name= pose= slot=) ;;
    'view.delete') reply=(id=) ;;
    'view.go') reply=(id=) ;;
    'view.rename') reply=(id= name=) ;;
    'view.save') reply=(name= pose=) ;;
    'zoom.move') reply=(factor= speed=) ;;
    *) reply=() ;;
  esac
}

_obsbot4linux() {
  local cur=${words[CURRENT]} prev=${words[CURRENT-1]} sub= action= i=2
  local -a reply
  local -a get_paths=(
    asleep audio audio.auto_gain audio.enabled audio.in_sleep audio.noise_reduction audio.volume
    available exposure exposure.anti_flicker exposure.compensation exposure.gain exposure.hdr
    exposure.mode exposure.region exposure.time focus focus.mode focus.position focus.region
    framing framing.auto_zoom framing.offset framing.offset.x framing.offset.y framing.part
    framing.size framing.zoom_speed gestures gestures.direction_change gestures.dynamic_zoom
    gestures.target_lock gestures.zoom gestures.zoom_ratio gimbal gimbal.invert gimbal.pan
    gimbal.tilt hand hand.area hand.area.pan hand.area.tilt hand.axes hand.axes.pan
    hand.axes.tilt hand.move_gimbal hand.return hand.return_after hand.side image
    image.brightness image.contrast image.frame_rate image.hue image.mirror image.saturation
    image.sharpness image.white_balance image.white_balance.auto image.white_balance.temperature
    led led.blink led.brightness on_air on_air.active on_air.apps pending power_on power_on.mode
    power_on.settings power_on.settings.auto_exposure power_on.settings.autofocus
    power_on.settings.contrast power_on.settings.exposure_compensation power_on.settings.hue
    power_on.settings.saturation power_on.settings.sharpness power_on.settings.tracking_speed
    power_on.settings.white_balance_mode power_on.settings.white_balance_temperature
    power_on.start power_on.start.mode power_on.start.pose power_on.start.source presets sleep
    sleep.auto sleep.auto.enabled sleep.auto.seconds sleep.background sleep.background_mirror
    sleep.wake_zoom tracking tracking.mode tracking.profile tracking.speed tracking.target
    tracking.target.box tracking.target.detected unread views zone zone.area zone.area.pan
    zone.area.tilt zone.enabled zone.follow zone.return zoom zoom.factor zoom.field_of_view
  )
  local -a describe_names=(
    asleep audio.auto_gain audio.enabled audio.in_sleep audio.noise_reduction audio.volume
    exposure.anti_flicker exposure.compensation exposure.gain exposure.hdr exposure.mode
    exposure.region exposure.time factory_reset focus.mode focus.point focus.position
    focus.region framing.auto_zoom framing.offset.x framing.offset.y framing.part framing.size
    framing.zoom_speed gestures.direction_change gestures.dynamic_zoom gestures.target_lock
    gestures.zoom gestures.zoom_ratio gimbal.invert gimbal.move gimbal.pan gimbal.stop
    gimbal.tilt gimbal.turn hand.area.pan hand.area.tilt hand.area_reset hand.axes.pan
    hand.axes.tilt hand.go_return hand.move_gimbal hand.return hand.return_after
    hand.return_clear hand.return_here hand.side image.brightness image.contrast
    image.frame_rate image.hue image.mirror image.saturation image.sharpness
    image.white_balance.auto image.white_balance.temperature led.blink led.brightness
    on_air.active on_air.apps power_on.go power_on.mode power_on.set_pose
    power_on.settings.auto_exposure power_on.settings.autofocus power_on.settings.contrast
    power_on.settings.exposure_compensation power_on.settings.hue power_on.settings.saturation
    power_on.settings.sharpness power_on.settings.tracking_speed
    power_on.settings.white_balance_mode power_on.settings.white_balance_temperature
    power_on.start.mode power_on.start.pose power_on.start.source power_on.use_current
    power_on.use_preset preset.delete preset.recall preset.rename preset.save presets sleep
    sleep.auto.enabled sleep.auto.seconds sleep.background sleep.background_mirror
    sleep.wake_zoom tracking.mode tracking.profile tracking.speed tracking.target.box
    tracking.target.detected view.delete view.go view.rename view.save views wake zone.area.pan
    zone.area.tilt zone.enabled zone.follow zone.go_return zone.return zone.return_here
    zoom.factor zoom.field_of_view zoom.move zoom.stop
  )
  local -a set_paths=(
    audio.auto_gain= audio.enabled= audio.in_sleep= audio.noise_reduction= audio.volume=
    exposure.anti_flicker= exposure.compensation= exposure.gain= exposure.hdr= exposure.mode=
    exposure.region= exposure.time= focus.mode= focus.position= focus.region= framing.auto_zoom=
    framing.offset.x= framing.offset.y= framing.part= framing.size= framing.zoom_speed=
    gestures.direction_change= gestures.dynamic_zoom= gestures.target_lock= gestures.zoom=
    gestures.zoom_ratio= gimbal.invert= hand.area.pan= hand.area.tilt= hand.axes.pan=
    hand.axes.tilt= hand.move_gimbal= hand.return_after= hand.side= image.brightness=
    image.contrast= image.hue= image.mirror= image.saturation= image.sharpness=
    image.white_balance.auto= image.white_balance.temperature= led.blink= led.brightness=
    power_on.mode= power_on.start.mode= sleep.auto.enabled= sleep.auto.seconds=
    sleep.background= sleep.background_mirror= sleep.wake_zoom= tracking.mode= tracking.profile=
    tracking.speed= zone.area.pan= zone.area.tilt= zone.enabled= zone.follow= zoom.factor=
    zoom.field_of_view=
  )
  local -a actions=(
    factory_reset focus.point gimbal.move gimbal.stop gimbal.turn hand.area_reset hand.go_return
    hand.return_clear hand.return_here power_on.go power_on.set_pose power_on.use_current
    power_on.use_preset preset.delete preset.recall preset.rename preset.save sleep view.delete
    view.go view.rename view.save wake zone.go_return zone.return_here zoom.move zoom.stop
  )
  while (( i < CURRENT )); do
    case ${words[i]} in
      --device) (( i += 2 )); continue ;;
      -*) ;;
      *)
        if [[ -z $sub ]]; then
          sub=${words[i]}
        elif [[ $sub == do && -z $action ]]; then
          action=${words[i]}
        fi
        ;;
    esac
    (( i++ ))
  done
  if [[ $prev == --device ]]; then
    return 1
  fi
  if [[ $cur == -* ]]; then
    case $sub in
      devices) compadd -- --report --json --device --help --version ;;
      watch) compadd -- --live --json --device --help --version ;;
      *) compadd -- --json --device --help --version ;;
    esac
    return
  fi
  if [[ -z $sub ]]; then
    compadd -- status get set do describe devices watch
    return
  fi
  case $sub in
    get) compadd -- $get_paths ;;
    describe) compadd -- $describe_names ;;
    set)
      if [[ $cur == *=* ]]; then
        _obsbot4linux_values ${cur%%=*}
        compadd -P "${cur%%=*}=" -- $reply
      else
        compadd -S '' -- $set_paths
      fi
      ;;
    do)
      if [[ -z $action ]]; then
        compadd -- $actions
      elif [[ $cur == *=* ]]; then
        _obsbot4linux_values "$action ${cur%%=*}"
        compadd -P "${cur%%=*}=" -- $reply
      else
        _obsbot4linux_params $action
        compadd -S '' -- $reply
      fi
      ;;
    watch) compadd -- auto pose target ;;
  esac
}

_obsbot4linux "$@"
