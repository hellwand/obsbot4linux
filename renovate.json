{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "timezone": "Europe/Berlin",
  "schedule": ["* 0-5 * * 1"],
  "dependencyDashboard": true,
  "automerge": false,
  "enabledManagers": ["cargo", "github-actions", "custom.regex"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-5 1-7 * 1"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Container images pinned by digest in the release workflow (arch_image keys)",
      "managerFilePatterns": ["/^\\.github/workflows/release\\.yml$/"],
      "matchStrings": ["arch_image:\\s*(?<depName>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"],
      "datasourceTemplate": "docker",
      "currentValueTemplate": "latest"
    },
    {
      "customType": "regex",
      "description": "Tools installed with cargo install --locked in the release workflow",
      "managerFilePatterns": ["/^\\.github/workflows/release\\.yml$/"],
      "matchStrings": [
        "cargo install --locked (?<depName>[a-z0-9_-]+)@(?<currentValue>[0-9][0-9.]*)"
      ],
      "datasourceTemplate": "crate",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "cargo minor and patch",
      "groupSlug": "cargo-minor-patch"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "github-actions minor and patch",
      "groupSlug": "github-actions-minor-patch"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "groupName": "container images",
      "groupSlug": "container-images"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["crate"],
      "groupName": "release tooling",
      "groupSlug": "release-tooling"
    },
    {
      "matchUpdateTypes": ["major"],
      "groupName": null
    }
  ]
}
