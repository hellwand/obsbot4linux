#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Stands in for ffmpeg in tests/check_model.rs (on PATH before the real one): the stream of
# `check-model.sh --observe`. It behaves as measured on 2026-11-26 on the Tiny 2 Lite: opened
# while the camera is asleep it gets no frame at all (also after a wake), and while it gets
# no frame SIGTERM does not end it; SIGINT does (ffmpeg sets its own SIGINT handler, so the
# SIGINT that bash ignores in a background job reaches it; a shell script could not). Opened
# awake it writes one grey frame to its last argument five times a second. Its pid goes to
# $FAKE_FFMPEG_PIDFILE; with FAKE_FFMPEG_NO_FRAMES=1 it never writes a frame.
import json
import os
import signal
import subprocess
import sys
import time

signal.signal(signal.SIGTERM, signal.SIG_IGN)
signal.signal(signal.SIGINT, lambda *_: os._exit(255))
with open(os.environ["FAKE_FFMPEG_PIDFILE"], "w") as f:
    f.write(f"{os.getpid()}\n")
out = sys.argv[-1]
status = subprocess.run(
    [os.environ["FAKE_FFMPEG_CLI"], "status", "--json", "--device", "fake-a"],
    capture_output=True,
    check=True,
)
asleep = json.loads(status.stdout)["state"]["asleep"]
frames = not asleep and os.environ.get("FAKE_FFMPEG_NO_FRAMES") != "1"
frame = b"P5\n320 180\n255\n" + bytes([128]) * (320 * 180)
while True:
    if frames:
        with open(out + ".tmp", "wb") as f:
            f.write(frame)
        os.replace(out + ".tmp", out)
    time.sleep(0.2)
